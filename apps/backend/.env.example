# KiranaSathi Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Local, Docker, or MongoDB Atlas)
# Variable name: MONGODB_URI (MONGO_URI is also accepted as fallback)
#
# Option A: Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/kiranasathi
#
# Option B: MongoDB Atlas (Cloud)
# 1. Replace <username> and <password> with your Atlas database user credentials.
# 2. If your password contains special characters (e.g., @, :, /, %, #), URL-encode them.
# 3. Ensure the database name (/kiranasathi) is included before query parameters.
# 4. In Atlas Network Access, ensure your current IP address (or 0.0.0.0/0 for dev) is added.
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/kiranasathi?retryWrites=true&w=majority
#
# Option C: Offline-only mode
# Leave MONGODB_URI blank or unset. KiranaSathi will operate using client IndexedDB & in-memory backend fallbacks.
MONGODB_URI=mongodb://127.0.0.1:27017/kiranasathi

